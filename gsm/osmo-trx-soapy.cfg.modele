! MODÈLE de configuration osmo-trx-soapy pour le Fishball horodaté.
! Ce fichier n'est utilisé par rien : le copier en /config/osmo-trx-soapy.cfg et l'adapter.
! Il ne concerne que la couche radio (TRX). La BTS, le BSC et le cœur ne sont pas configurés ici.
log stderr
 logging filter all 1
 logging color 1
 logging print category 1
 logging timestamp 1
 logging print level 1
 logging level set-all notice
!
line vty
 no login
!
trx
 ! Adresses vers osmo-bts-trx (TRXC/TRXD, ports 5700+ par défaut). 127.0.0.1 si tout est sur la même machine.
 bind-ip 127.0.0.1
 remote-ip 127.0.0.1
 ! Ethernet : hostname=<IP de la carte>. USB : retirer hostname (le pilote cherche la carte en USB).
 ! timestamp_every doit rester égal à SOAPY_PACKET_SIZE_SAMPLES (2500) du pilote soapy_trx.
 dev-args driver=plutosdr,hostname=A_REMPLIR,direct=1,loopback=0,timestamp_every=2500
 ! 4 échantillons par symbole GSM = 1,0833 Méch/s ; le pilote exige tx-sps = rx-sps.
 tx-sps 4
 rx-sps 4
 chan 0
  tx-path A
  rx-path A_BALANCED
