#!/bin/sh
# Mode économie d'énergie du Fishball (interface web à la demande, veille de l'AD9363)
# Réglages : /boot/eco.conf
case "$1" in
	start)   printf "Starting eco: "; /usr/sbin/eco boot; echo "OK" ;;
	stop)    /usr/sbin/eco pause ;;
	restart) /usr/sbin/eco pause; /usr/sbin/eco boot ;;
	*)       echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
