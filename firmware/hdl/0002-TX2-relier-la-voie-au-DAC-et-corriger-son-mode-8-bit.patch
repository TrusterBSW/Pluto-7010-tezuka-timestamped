From 4161156e21aa7acd3e6c36829e37e143700196b4 Mon Sep 17 00:00:00 2001
From: TrusterBSW <noreply@users.noreply.github.com>
Date: Fri, 27 Nov 2026 09:53:37 +0000
Subject: [PATCH 2/2] TX2 : relier la voie au DAC et corriger son mode 8 bits

La sortie des mux TX2 n etait reliee a rien (din_data_2/3 du FIFO DAC en
l air) : la 2e voie TX emettait des zeros dans tous les modes. Elle est
maintenant reliee en direct (sans l interpolateur x32, qui n a que 2 voies).
Mode 8 bits TX2 : enable_in_1 de I et Q remis dans le bon ordre, octets
sur les bits 15..8 comme la voie 1, et dac_force_dma sur Q1 dans le patch
axi_ad9361.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../adi-hdl/axi_ad9361-tx-cs8-force-dma.patch | 46 +++++++++----------
 maia-hdl/projects/pluto/system_bd.tcl         | 23 ++++++----
 2 files changed, 36 insertions(+), 33 deletions(-)

diff --git a/maia-hdl/patches/adi-hdl/axi_ad9361-tx-cs8-force-dma.patch b/maia-hdl/patches/adi-hdl/axi_ad9361-tx-cs8-force-dma.patch
index 0c6f962..78ddf6e 100644
--- a/maia-hdl/patches/adi-hdl/axi_ad9361-tx-cs8-force-dma.patch
+++ b/maia-hdl/patches/adi-hdl/axi_ad9361-tx-cs8-force-dma.patch
@@ -1,25 +1,5 @@
---- library/axi_ad9361/axi_ad9361_tx_channel.v	2026-11-05 13:32:38.712051766 +0000
-+++ library/axi_ad9361/axi_ad9361_tx_channel.v	2026-11-24 20:41:31.576265439 +0000
-@@ -65,6 +65,7 @@
-   // processor interface
- 
-   output          dac_enable,
-+  input           dac_force_dma,
-   input           dac_data_sync,
-   input           dac_dds_format,
- 
-@@ -300,7 +301,8 @@
-       4'h3: dac_data_out_int <= 12'd0;
-       4'h2: dac_data_out_int <= dma_data[15:4];
-       4'h1: dac_data_out_int <= dac_pat_data[15:4];
--      default: dac_data_out_int <= dac_dds_data_s;
-+      // TX 8 bits : I seul en DMA, Q deduit du meme mot -> Q suit la donnee DMA au lieu du DDS
-+      default: dac_data_out_int <= dac_force_dma ? dma_data[15:4] : dac_dds_data_s;
-     endcase
-   end
- 
---- library/axi_ad9361/axi_ad9361_tx.v	2026-11-05 13:32:38.712051766 +0000
-+++ library/axi_ad9361/axi_ad9361_tx.v	2026-11-24 20:41:31.580265517 +0000
+--- a/library/axi_ad9361/axi_ad9361_tx.v
++++ b/library/axi_ad9361/axi_ad9361_tx.v
 @@ -242,6 +242,7 @@
      .dac_data_out (dac_data_int_s[11:0]),
      .dac_data_in (dac_data_int_s[23:12]),
@@ -48,7 +28,27 @@
      .dac_data_out (dac_data_int_s[47:36]),
      .dac_data_in (dac_data_int_s[35:24]),
      .dac_enable (dac_enable_q1),
-+    .dac_force_dma (1'b0),
++    .dac_force_dma (dac_enable_i1 & ~dac_enable_q1),
      .dac_data_sync (dac_data_sync),
      .dac_dds_format (dac_dds_format_s),
      .up_rstn (up_rstn),
+--- a/library/axi_ad9361/axi_ad9361_tx_channel.v
++++ b/library/axi_ad9361/axi_ad9361_tx_channel.v
+@@ -65,6 +65,7 @@
+   // processor interface
+ 
+   output          dac_enable,
++  input           dac_force_dma,
+   input           dac_data_sync,
+   input           dac_dds_format,
+ 
+@@ -300,7 +301,8 @@
+       4'h3: dac_data_out_int <= 12'd0;
+       4'h2: dac_data_out_int <= dma_data[15:4];
+       4'h1: dac_data_out_int <= dac_pat_data[15:4];
+-      default: dac_data_out_int <= dac_dds_data_s;
++      // TX 8 bits : I seul en DMA, Q deduit du meme mot -> Q suit la donnee DMA au lieu du DDS
++      default: dac_data_out_int <= dac_force_dma ? dma_data[15:4] : dac_dds_data_s;
+     endcase
+   end
+ 
diff --git a/maia-hdl/projects/pluto/system_bd.tcl b/maia-hdl/projects/pluto/system_bd.tcl
index cbbf092..1c23c87 100644
--- a/maia-hdl/projects/pluto/system_bd.tcl
+++ b/maia-hdl/projects/pluto/system_bd.tcl
@@ -1211,10 +1211,10 @@ if {[info exists maia_iio]} {
 
 	ad_ip_instance xlconcat concatslicetx_i2
 
-	ad_ip_parameter concatslicetx_i2 CONFIG.NUM_PORTS 3
-	ad_ip_parameter concatslicetx_i2 CONFIG.IN0_WIDTH 4
+	# TX2 8 bits : octet sur les bits 15..8, comme la voie 1 (avant : 11..4, soit 24 dB de moins)
+	ad_ip_parameter concatslicetx_i2 CONFIG.NUM_PORTS 2
+	ad_ip_parameter concatslicetx_i2 CONFIG.IN0_WIDTH 8
 	ad_ip_parameter concatslicetx_i2 CONFIG.IN1_WIDTH 8
-	ad_ip_parameter concatslicetx_i2 CONFIG.IN2_WIDTH 4
 
 	ad_connect shiftsliceitx2/Dout concatslicetx_i2/In1
 
@@ -1227,10 +1227,10 @@ if {[info exists maia_iio]} {
 	ad_connect util_ad9361_dac_upack/fifo_rd_data_2 shiftsliceqtx2/Din
 
 	ad_ip_instance xlconcat concatslicetx_q2
-	ad_ip_parameter concatslicetx_q2 CONFIG.NUM_PORTS 3
-	ad_ip_parameter concatslicetx_q2 CONFIG.IN0_WIDTH 4
+	# TX2 8 bits : octet sur les bits 15..8, comme la voie 1 (avant : 11..4, soit 24 dB de moins)
+	ad_ip_parameter concatslicetx_q2 CONFIG.NUM_PORTS 2
+	ad_ip_parameter concatslicetx_q2 CONFIG.IN0_WIDTH 8
 	ad_ip_parameter concatslicetx_q2 CONFIG.IN1_WIDTH 8
-	ad_ip_parameter concatslicetx_q2 CONFIG.IN2_WIDTH 4
 
 	ad_connect shiftsliceqtx2/Dout concatslicetx_q2/In1
 
@@ -1250,10 +1250,13 @@ if {[info exists maia_iio]} {
 	ad_connect util_ad9361_dac_upack/fifo_rd_data_2 muxcs8_tx_i2/data_in_0
 	#Second input C8 - > CS16 > I0
 	ad_connect concatslicetx_i2/Dout muxcs8_tx_i2/data_in_1
-	ad_connect muxcs8_tx_i2/enable_in_1 axi_ad9361_dac_fifo/din_enable_3
+	# CS8 : I1 seul actif -> upack enable_2 = 1 (avant : din_enable_3, inverse avec Q)
+	ad_connect muxcs8_tx_i2/enable_in_1 axi_ad9361_dac_fifo/din_enable_2
 
 	#OUT
-	#ad_connect muxcs8_tx_i2/data_out axi_ad9361_dac_fifo/din_data_2
+	# TX2 : sortie reliee au DAC (avant : rien, la voie TX2 emettait des zeros dans tous les modes).
+	# En direct, sans l interpolateur x32 (2 voies seulement) : TX2 n est juste qu interpolateur inactif.
+	ad_connect muxcs8_tx_i2/data_out axi_ad9361_dac_fifo/din_data_2
 	ad_connect muxcs8_tx_i2/enable_out util_ad9361_dac_upack/enable_2
 
 	#Select input depending on dac_qo_enable
@@ -1266,10 +1269,10 @@ if {[info exists maia_iio]} {
 	ad_connect util_ad9361_dac_upack/fifo_rd_data_3 muxcs8_tx_q2/data_in_0
 	#Second input C8 - > CS16 > I0
 	ad_connect concatslicetx_q2/Dout muxcs8_tx_q2/data_in_1
-	ad_connect muxcs8_tx_q2/enable_in_1 axi_ad9361_dac_fifo/din_enable_2
+	ad_connect muxcs8_tx_q2/enable_in_1 axi_ad9361_dac_fifo/din_enable_3
 
 	#OUT
-	#ad_connect muxcs8_tx_q2/data_out axi_ad9361_dac_fifo/din_data_3
+	ad_connect muxcs8_tx_q2/data_out axi_ad9361_dac_fifo/din_data_3
 	ad_connect muxcs8_tx_q2/enable_out util_ad9361_dac_upack/enable_3
 
 
-- 
